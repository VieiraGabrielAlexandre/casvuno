# Casvuno — single .gitignore for the whole monorepo.
# Patterns without a leading slash match at any depth (apps/api, apps/web, packages/*).

# --- Secrets and local configuration -------------------------------------------
# Real configuration never goes to git; only the documented example does.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
# age keys (encrypted backups, ADR 0012)
*.agekey
age-key*.txt

# --- Database dumps and backups ------------------------------------------------
# Never commit backups, encrypted or not (README §9). Migrations (*.sql) are tracked.
backups/
*.dump
*.backup
*.sql.gz
*.age

# --- Go (apps/api) -------------------------------------------------------------
# Built binaries and locally installed tools (golangci-lint)
bin/
*.exe
*.test
*.out
*.prof
coverage.*
# Local multi-module workspaces are personal setup
go.work
go.work.sum

# --- Node / pnpm ---------------------------------------------------------------
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Next.js (apps/web) --------------------------------------------------------
.next/
# static export output (make build)
out/
# regenerated by next dev / next typegen
next-env.d.ts
*.tsbuildinfo

# --- Tests and reports ---------------------------------------------------------
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Docker --------------------------------------------------------------------
# Personal Compose overrides
compose.override.yaml
compose.override.yml
docker-compose.override.yml

# --- Editors, OS and temporary files -------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
tmp/
*.log

# --- AI assistants (local-only settings; AGENTS.md and CLAUDE.md are tracked) ----
.claude/settings.local.json
