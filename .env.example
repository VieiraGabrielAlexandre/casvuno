# Copy to .env (`make setup` does it) and adjust. Never commit .env.
# Values below are local-development placeholders, not secrets.

# --- PostgreSQL (Docker Compose) ---
POSTGRES_USER=casvuno
# Use only URL-safe characters: it is interpolated into DATABASE_URL.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=casvuno
# Host ports (bound to 127.0.0.1).
POSTGRES_HOST_PORT=55432
API_HOST_PORT=8090

# --- API ---
# development | production | test
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
# Origin of the web app (scheme://host[:port], no path). Only this origin may send
# state-changing requests (CSRF), invite links point to it, and an https origin makes the
# session cookie Secure (__Host- prefix). Must be https in production.
APP_ORIGIN=http://localhost:3000
# Public sign-up. Set to false once your family has registered: invited people can still sign up.
REGISTRATION_ENABLED=true
# The two settings below apply only when the API runs directly on the host (`make api`).
# Inside Compose the API listens on :8080 and reaches the database at db:5432.
HTTP_ADDR=127.0.0.1:8090
DATABASE_URL=postgres://casvuno:change-me-local-only@localhost:55432/casvuno?sslmode=disable

# --- Web (next dev) ---
# Where the dev server proxies /api/* and /health.
API_URL=http://localhost:8090
